{
  "name": "cricket-scorer",
  "private": true,
  "description": "Live cricket scoring: score on one phone, everyone watches the link live.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/cricket-score",
    "build": "npm run build -w apps/cricket-score",
    "typecheck": "tsc -p apps/cricket-score/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^24.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
